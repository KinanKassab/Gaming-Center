{
  "name": "akodus-gaming-center",
  "version": "0.1.0",
  "private": true,
  "description": "Akodus Gaming Center — multi-tenant SaaS foundation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node ./scripts/canonical-next.mjs dev",
    "build": "node ./scripts/canonical-next.mjs build",
    "start": "node ./scripts/canonical-next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:supabase": "vitest run --config vitest.supabase.config.ts",
    "browser:fixture": "tsx scripts/browser-fixture.ts",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "browser:responsive": "node scripts/browser-responsive.mjs",
    "db:migrate": "tsx src/db/run-migrate.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.2",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
